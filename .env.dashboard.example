# Copy to .env.dashboard or .env.dashboard.local and fill with your own values.
# Do not commit the real file.
# This file is only for the repository script upload flow.
# If a device is bound through the browser with a one-time device invite code,
# it does not need these admin credentials locally.

# Optional if your workspace does not use workflow/content-library or content-library.
# CONTENT_LIBRARY_ROOT=workflow/content-library

DASHBOARD_API_BASE=http://your-dashboard-host:8080
DASHBOARD_ACCOUNT_NAME=your-account-group
# DASHBOARD_WORKSPACE_NAME=your-workspace-name
DASHBOARD_ADMIN_USERNAME=your-admin-username
DASHBOARD_ADMIN_PASSWORD=your-admin-password
